body {
  font-family: system-ui, sans-serif;
  text-align: center;
  background: #f7f7f9;
  color: #222;
  margin: 0;
  padding: 40px 20px;
}

h1 { margin-bottom: 4px; }
.subtitle { color: #777; margin-top: 0; }

#bars {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 4px;
  height: 320px;
  margin: 30px auto;
  max-width: 800px;
}

.bar {
  width: 26px;
  background: #4a7bd0;
  border-radius: 3px 3px 0 0;
  transition: height 0.1s;
}

.bar.active { background: #e0a020; }  /* bars being compared */
.bar.sorted { background: #3aa76d; }  /* finished bars */

.controls {
  display: flex;
  gap: 12px;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
}

button {
  padding: 10px 22px;
  font-size: 15px;
  border: none;
  border-radius: 6px;
  background: #4a7bd0;
  color: white;
  cursor: pointer;
}

button:hover { background: #3a63aa; }
button:disabled { background: #b0b8c4; cursor: default; }

input[type="range"] { vertical-align: middle; }

.stats { margin-top: 24px; color: #555; font-variant-numeric: tabular-nums; }